    <MemoryView><Text>demo struct</Text><BaseAddress>0x20001000</BaseAddress><NumBytes>256</NumBytes><BytesPerLine>16</BytesPerLine><LittleEndian>true</LittleEndian></MemoryView>
    <MemoryEditor>
      <Text>editor</Text><BaseAddress>0x20001000</BaseAddress><Size>1024</Size><Cols>16</Cols>
      <ReadOnly>false</ReadOnly><ShowAscii>true</ShowAscii><ShowHexII>false</ShowHexII><ShowOptions>true</ShowOptions>
      <ShowPreview>true</ShowPreview><GreyZero>true</GreyZero><UpperHex>true</UpperHex><LittleEndian>true</LittleEndian>
      <UseExternal>true</UseExternal><UseCache>true</UseCache>
